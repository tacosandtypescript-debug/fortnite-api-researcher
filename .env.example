# Fortnite-API.com
# La API pública permite consultas generales sin key. Añádela cuando la tengas
# para habilitar rutas que la requieran, como estadísticas de jugadores.
FORTNITE_API_KEY=
FORTNITE_API_BASE_URL=https://fortnite-api.com
# Hostnames autorizados para enviar la API key; no uses URLs completas.
FORTNITE_API_TRUSTED_HOSTS=fortnite-api.com,www.fortnite-api.com
FORTNITE_API_TIMEOUT=30
# Ruta de salida relativa a la raíz del proyecto o absoluta.
FORTNITE_OUTPUT_DIR=salidas

# Telegram Bot API
# No pegues estos valores en README, código ni commits.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = cada consulta guardada se envía automáticamente como documento.
# No puede combinarse con TELEGRAM_ALLOW_CHAT_DISCOVERY=true: el proceso falla
# con un error explícito para no enviar nada a un chat descubierto por error.
AUTO_SEND_TELEGRAM=false
# true = permite buscar chats recientes si TELEGRAM_CHAT_ID está vacío.
# Déjalo en false para evitar enviar documentos al chat equivocado.
TELEGRAM_ALLOW_CHAT_DISCOVERY=false

# Penny (alertas de Salvar el Mundo). Solo se aceptan los hostnames pennydb.net
# y beta.pennydb.net; cualquier otro valor detiene el arranque.
PENNY_API_BASE_URL=https://pennydb.net
# Segundos entre consultas del comando `bot`.
PENNY_POLL_INTERVAL_SECONDS=600
# Solo se notifican novedades con una fecha dentro de esta ventana.
# La primera ejecución crea la línea base y no reenvía el catálogo existente.
PENNY_NEW_CONTENT_MAX_AGE_HOURS=24
